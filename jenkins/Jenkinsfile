pipeline {
    agent {
        label 'orderflow'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    triggers {
        githubPush()
    }

    environment {
        UV_LINK_MODE = 'copy'

        AZURE_CONFIG_DIR      = "${WORKSPACE}/.azure"
        AZURE_SUBSCRIPTION_ID = '9067ae35-ee11-45a5-bfc1-11556de9b246'
        AZURE_CLIENT_ID       = '4cf9718b-5495-42c9-90d4-0762ff53685c'
        ORDERFLOW_API_CLIENT_ID = 'c098978c-a5c8-4864-8ad7-ec5b2a1f74b8'
        AZURE_RESOURCE_GROUP  = 'rg-orderflow-staging-swe'
        ACR_NAME              = 'acrorderflowmouadswe'
        ACR_LOGIN_SERVER      = 'acrorderflowmouadswe.azurecr.io'
        CONTAINER_APP_NAME    = 'ca-orderflow-api-staging-swe'
        MIGRATION_JOB_NAME    = 'caj-orderflow-migrate-swe'

        PRODUCTION_RESOURCE_GROUP    = 'rg-orderflow-production-swe'
        PRODUCTION_CONTAINER_APP     = 'ca-orderflow-api-production-swe'
        PRODUCTION_MIGRATION_JOB     = 'caj-orderflow-migrate-prod-swe'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm

                script {
                    env.IMAGE_TAG = sh(
                        script: 'git rev-parse HEAD',
                        returnStdout: true
                    ).trim()

                    env.API_IMAGE = "${env.ACR_LOGIN_SERVER}/orderflow-api:${env.IMAGE_TAG}"
                }
            }
        }

        stage('Verify lockfile') {
            steps {
                sh 'uv lock --check'
                sh 'uv sync --frozen'
            }
        }

        stage('Validate Terraform') {
            steps {
                sh '''
                    for directory in \
                      terraform/bootstrap \
                      terraform/environments/jenkins-swe \
                      terraform/environments/staging \
                      terraform/environments/staging-swe \
                      terraform/environments/production; do
                      echo "Validating ${directory}"

                      terraform -chdir="${directory}" fmt -check -recursive
                      terraform -chdir="${directory}" init \
                        -backend=false \
                        -input=false \
                        -no-color
                      terraform -chdir="${directory}" validate -no-color
                    done
                '''
            }
        }

        stage('Scan Terraform configuration') {
            steps {
                sh '''
                    trivy config \
                        --skip-version-check \
                        --misconfig-scanners terraform \
                        --skip-dirs '.terraform' \
                        --ignorefile .trivyignore.yaml \
                        --exit-code 1 \
                        --severity CRITICAL,HIGH \
                        terraform
                '''
            }
        }

        stage('Format and lint') {
            steps {
                sh 'uv run ruff format --check .'
                sh 'uv run ruff check .'
            }
        }

        stage('Unit tests') {
            steps {
                sh 'uv run pytest tests/unit -q'
            }
        }

        stage('PostgreSQL integration tests') {
            steps {
                sh 'uv run pytest tests/integration -q'
            }
        }

        stage('Build API image') {
            steps {
                sh '''
                    docker build \
                      --file docker/Dockerfile.api \
                      --build-arg "BUILD_SHA=${IMAGE_TAG}" \
                      --tag "orderflow-api:${IMAGE_TAG}" \
                      .

                    docker image inspect "orderflow-api:${IMAGE_TAG}"
                '''
            }
        }

        stage('Scan API image') {
            steps {
                sh '''
                    docker run --rm \
                        --security-opt no-new-privileges \
                        -v /var/run/docker.sock:/var/run/docker.sock \
                        -v trivy-cache:/root/.cache \
                        aquasec/trivy:0.76.0 image \
                            --scanners vuln \
                            --exit-code 1 \
                            --severity CRITICAL,HIGH \
                            --ignore-unfixed \
                            "orderflow-api:${IMAGE_TAG}"
                '''
            }
        }

        stage('Authenticate to Azure') {
            when {
                branch 'main'
            }

            steps {
                sh '''
                    az login \
                        --identity \
                        --client-id "${AZURE_CLIENT_ID}" \
                        --output none

                    az account set \
                        --subscription "${AZURE_SUBSCRIPTION_ID}"

                    az account show \
                        --query '{Subscription:id,Identity:user.name}' \
                        --output json
                '''
            }
        }

        stage('Publish API image') {
            when {
                branch 'main'
            }

            steps {
                sh '''
                    az acr login \
                        --name "${ACR_NAME}" \
                        --output none

                    docker tag \
                        "orderflow-api:${IMAGE_TAG}" \
                        "${API_IMAGE}"

                    docker push "${API_IMAGE}"
                '''
            }
        }

        stage('Resolve published image digest') {
            when {
                branch 'main'
            }

            steps {
                script {
                    env.API_IMAGE_DIGEST = sh(
                        script: '''
                            az acr manifest show-metadata \
                                --registry "${ACR_NAME}" \
                                --name "orderflow-api:${IMAGE_TAG}" \
                                --query digest \
                                --output tsv \
                                --only-show-errors
                        ''',
                        returnStdout: true
                    ).trim()

                    if (!(env.API_IMAGE_DIGEST ==~ /^sha256:[0-9a-f]{64}$/)) {
                        error("Azure returned an invalid image digest: ${env.API_IMAGE_DIGEST}")
                    }

                    env.API_IMAGE_BY_DIGEST = "${env.ACR_LOGIN_SERVER}/orderflow-api@${env.API_IMAGE_DIGEST}"
                    env.REVISION_SUFFIX = env.IMAGE_TAG.substring(0, 12)

                    echo "Immutable API image: ${env.API_IMAGE_BY_DIGEST}"
                }
            }
        }

        stage('Run staging migrations') {
            when {
                branch 'main'
            }

            steps {
                sh '''
                    az containerapp job update \
                        --name "${MIGRATION_JOB_NAME}" \
                        --resource-group "${AZURE_RESOURCE_GROUP}" \
                        --container-name migrate \
                        --image "${API_IMAGE_BY_DIGEST}" \
                        --output none \
                        --only-show-errors

                    execution_name="$(
                        az containerapp job start \
                            --name "${MIGRATION_JOB_NAME}" \
                            --resource-group "${AZURE_RESOURCE_GROUP}" \
                            --query name \
                            --output tsv \
                            --only-show-errors
                    )"

                    if [ -z "${execution_name}" ] || [ "${execution_name}" = "null" ]; then
                      echo "Azure did not return a migration execution name"
                      exit 1
                    fi

                    echo "Migration execution: ${execution_name}"

                    attempt=1

                    while [ "${attempt}" -le 90 ]; do
                      status="$(
                        az containerapp job execution show \
                          --name "${MIGRATION_JOB_NAME}" \
                          --resource-group "${AZURE_RESOURCE_GROUP}" \
                          --job-execution-name "${execution_name}" \
                          --query properties.status \
                          --output tsv \
                          --only-show-errors
                      )"

                      echo "Migration status: ${status}"

                      case "${status}" in
                        Succeeded)
                          exit 0
                          ;;
                        Failed|Degraded|Stopped)
                          az containerapp job execution show \
                            --name "${MIGRATION_JOB_NAME}" \
                            --resource-group "${AZURE_RESOURCE_GROUP}" \
                            --job-execution-name "${execution_name}" \
                            --output json

                          exit 1
                          ;;
                      esac

                      sleep 10
                      attempt=$((attempt + 1))
                    done

                    echo "Migration execution timed out"
                    exit 1
                '''
            }
        }

        stage('Deploy staging API') {
            when {
                branch 'main'
            }

            steps {
                sh '''
                    az containerapp update \
                      --name "${CONTAINER_APP_NAME}" \
                      --resource-group "${AZURE_RESOURCE_GROUP}" \
                      --image "${API_IMAGE_BY_DIGEST}" \
                      --output none \
                      --only-show-errors
                '''
            }
        }

        stage('Verify staging') {
            when {
                branch 'main'
            }

            steps {
                sh '''
                    api_fqdn="$(
                      az containerapp show \
                          --name "${CONTAINER_APP_NAME}" \
                          --resource-group "${AZURE_RESOURCE_GROUP}" \
                          --query properties.configuration.ingress.fqdn \
                          --output tsv \
                          --only-show-errors
                    )"

                    if [ -z "${api_fqdn}" ] || [ "${api_fqdn}" = "null" ]; then
                      echo "Azure did not return the staging API hostname"
                      exit 1
                    fi

                    api_url="https://${api_fqdn}"
                    echo "Verifying ${api_url}"

                    curl \
                      --fail \
                      --silent \
                      --show-error \
                      --retry 24 \
                      --retry-all-errors \
                      --retry-delay 5 \
                      "${api_url}/health"

                    attempt=1

                    while [ "${attempt}" -le 24 ]; do
                      info_response="$(
                        curl \
                          --fail \
                          --silent \
                          --show-error \
                          "${api_url}/info"
                      )" || {
                        echo "Could not read staging build identity"
                        exit 1
                      }

                      staging_build_sha="$(printf '%s' "${info_response}" | jq -r '.build_sha')"

                      echo "Staging build SHA: ${staging_build_sha}"

                      if [ "${staging_build_sha}" = "${IMAGE_TAG}" ]; then
                        break
                      fi

                      sleep 5
                      attempt=$((attempt + 1))
                    done

                    if [ "${staging_build_sha}" != "${IMAGE_TAG}" ]; then
                      echo "Staging did not begin serving expected build ${IMAGE_TAG}"
                      exit 1
                    fi

                    set +x
                    api_access_token="$(
                      az account get-access-token \
                        --scope "api://${ORDERFLOW_API_CLIENT_ID}/.default" \
                        --query accessToken \
                        --output tsv \
                        --only-show-errors
                    )"

                    if [ -z "${api_access_token}" ]; then
                      echo "Could not acquire the OrderFlow API access token"
                      exit 1
                    fi

                    bash scripts/smoke-test.sh "${api_url}" "${IMAGE_TAG}" "${api_access_token}"
                    unset api_access_token
                '''
            }
        }

        stage('Approve production') {
            when {
                branch 'main'
            }

            steps {
                timeout(time: 24, unit: 'HOURS') {
                    script {
                        def forceProductionRollback = input(
                            message: "Promote ${env.API_IMAGE_BY_DIGEST} to production?",
                            ok: 'Promote',
                            parameters: [
                                booleanParam(
                                    name: 'FORCE_PRODUCTION_ROLLBACK',
                                    defaultValue: false,
                                    description: 'After candidate validation, intentionally roll production traffic back to prove the rollback path.'
                                )
                            ]
                        )

                        env.FORCE_PRODUCTION_ROLLBACK = forceProductionRollback.toString()
                    }
                }
            }
        }

        stage('Run production migrations') {
            when {
                branch 'main'
            }

            steps {
                sh '''
                    az containerapp job update \
                        --name "${PRODUCTION_MIGRATION_JOB}" \
                        --resource-group "${PRODUCTION_RESOURCE_GROUP}" \
                        --container-name migrate \
                        --image "${API_IMAGE_BY_DIGEST}" \
                        --output none \
                        --only-show-errors

                    execution_name="$(
                        az containerapp job start \
                            --name "${PRODUCTION_MIGRATION_JOB}" \
                            --resource-group "${PRODUCTION_RESOURCE_GROUP}" \
                            --query name \
                            --output tsv \
                            --only-show-errors
                    )"

                    if [ -z "${execution_name}" ] || [ "${execution_name}" = "null" ]; then
                      echo "Azure did not return a production migration execution name"
                      exit 1
                    fi

                    echo "Production migration execution: ${execution_name}"

                    attempt=1

                    while [ "${attempt}" -le 90 ]; do
                      status="$(
                        az containerapp job execution show \
                          --name "${PRODUCTION_MIGRATION_JOB}" \
                          --resource-group "${PRODUCTION_RESOURCE_GROUP}" \
                          --job-execution-name "${execution_name}" \
                          --query properties.status \
                          --output tsv \
                          --only-show-errors
                      )"

                      echo "Production migration status: ${status}"

                      case "${status}" in
                        Succeeded)
                          exit 0
                          ;;
                        Failed|Degraded|Stopped)
                          az containerapp job execution show \
                            --name "${PRODUCTION_MIGRATION_JOB}" \
                            --resource-group "${PRODUCTION_RESOURCE_GROUP}" \
                            --job-execution-name "${execution_name}" \
                            --output json

                          exit 1
                          ;;
                      esac

                      sleep 10
                      attempt=$((attempt + 1))
                    done

                    echo "Production migration execution timed out"
                    exit 1
                '''
            }
        }

        stage('Promote production revision') {
            when {
                branch 'main'
            }

            steps {
                sh '''
                    previous_revision="$(
                      az containerapp revision list \
                        --name "${PRODUCTION_CONTAINER_APP}" \
                        --resource-group "${PRODUCTION_RESOURCE_GROUP}" \
                        --output json \
                        --only-show-errors \
                      | jq -r '[.[] | select((.properties.trafficWeight // 0) > 0)][0].name // empty'
                    )"

                    if [ -z "${previous_revision}" ] || [ "${previous_revision}" = "null" ]; then
                      echo "Azure did not return the currently serving production revision"
                      exit 1
                    fi

                    previous_image="$(
                      az containerapp revision show \
                        --name "${PRODUCTION_CONTAINER_APP}" \
                        --resource-group "${PRODUCTION_RESOURCE_GROUP}" \
                        --revision "${previous_revision}" \
                        --output json \
                        --only-show-errors \
                      | jq -r '.properties.template.containers[] | select(.name == "api") | .image'
                    )"

                    stable_fqdn="$(
                      az containerapp show \
                        --name "${PRODUCTION_CONTAINER_APP}" \
                        --resource-group "${PRODUCTION_RESOURCE_GROUP}" \
                        --query properties.configuration.ingress.fqdn \
                        --output tsv \
                      --only-show-errors
                    )"

                    set +x
                    api_access_token="$(
                      az account get-access-token \
                        --scope "api://${ORDERFLOW_API_CLIENT_ID}/.default" \
                        --query accessToken \
                        --output tsv \
                        --only-show-errors
                    )"

                    if [ -z "${api_access_token}" ]; then
                      echo "Could not acquire the OrderFlow API access token"
                      exit 1
                    fi

                    set -x

                    run_authenticated_smoke_test() {
                      set +x
                      if bash scripts/smoke-test.sh "$1" "${IMAGE_TAG}" "${api_access_token}"; then
                        smoke_status=0
                      else
                        smoke_status=$?
                      fi
                      set -x
                      return "${smoke_status}"
                    }

                    if [ "${previous_image}" = "${API_IMAGE_BY_DIGEST}" ]; then
                      echo "Production already serves ${API_IMAGE_BY_DIGEST}"

                      curl \
                        --fail \
                        --silent \
                        --show-error \
                        --retry 24 \
                        --retry-all-errors \
                        --retry-delay 5 \
                        "https://${stable_fqdn}/ready"

                      run_authenticated_smoke_test "https://${stable_fqdn}"
                      unset api_access_token
                      exit 0
                    fi

                    echo "Current production revision: ${previous_revision}"

                    az containerapp ingress traffic set \
                      --name "${PRODUCTION_CONTAINER_APP}" \
                      --resource-group "${PRODUCTION_RESOURCE_GROUP}" \
                      --revision-weight "${previous_revision}=100" \
                      --output none \
                      --only-show-errors

                    candidate_revision="${PRODUCTION_CONTAINER_APP}--${REVISION_SUFFIX}"

                    if az containerapp revision show \
                      --name "${PRODUCTION_CONTAINER_APP}" \
                      --resource-group "${PRODUCTION_RESOURCE_GROUP}" \
                      --revision "${candidate_revision}" \
                      --output none \
                      --only-show-errors 2>/dev/null; then
                      echo "Reusing candidate revision ${candidate_revision}"
                    else
                      az containerapp revision copy \
                        --name "${PRODUCTION_CONTAINER_APP}" \
                        --resource-group "${PRODUCTION_RESOURCE_GROUP}" \
                        --from-revision "${previous_revision}" \
                        --container-name api \
                        --image "${API_IMAGE_BY_DIGEST}" \
                        --revision-suffix "${REVISION_SUFFIX}" \
                        --min-replicas 0 \
                        --max-replicas 1 \
                        --output none \
                        --only-show-errors
                    fi

                    echo "Production candidate revision: ${candidate_revision}"

                    attempt=1

                    while [ "${attempt}" -le 60 ]; do
                      provisioning_state="$(
                        az containerapp revision show \
                          --name "${PRODUCTION_CONTAINER_APP}" \
                          --resource-group "${PRODUCTION_RESOURCE_GROUP}" \
                          --revision "${candidate_revision}" \
                          --query properties.provisioningState \
                          --output tsv \
                          --only-show-errors
                      )"

                      echo "Candidate provisioning state: ${provisioning_state}"

                      case "${provisioning_state}" in
                        Provisioned)
                          break
                          ;;
                        Failed|Degraded)
                          echo "Production candidate failed to provision"
                          exit 1
                          ;;
                      esac

                      sleep 10
                      attempt=$((attempt + 1))
                    done

                    if [ "${provisioning_state}" != "Provisioned" ]; then
                      echo "Production candidate provisioning timed out"
                      exit 1
                    fi

                    candidate_fqdn="$(
                      az containerapp revision show \
                        --name "${PRODUCTION_CONTAINER_APP}" \
                        --resource-group "${PRODUCTION_RESOURCE_GROUP}" \
                        --revision "${candidate_revision}" \
                        --query properties.fqdn \
                        --output tsv \
                        --only-show-errors
                    )"

                    if [ -z "${candidate_fqdn}" ] || [ "${candidate_fqdn}" = "null" ]; then
                      echo "Azure did not return the candidate revision hostname"
                      exit 1
                    fi

                    echo "Validating zero-traffic candidate https://${candidate_fqdn}"

                    curl \
                      --fail \
                      --silent \
                      --show-error \
                      --retry 24 \
                      --retry-all-errors \
                      --retry-delay 5 \
                      "https://${candidate_fqdn}/health"

                    curl \
                      --fail \
                      --silent \
                      --show-error \
                      --retry 24 \
                      --retry-all-errors \
                      --retry-delay 5 \
                      "https://${candidate_fqdn}/ready"

                    run_authenticated_smoke_test "https://${candidate_fqdn}"

                    rollback_to_previous() {
                        az containerapp ingress traffic set \
                        --name "${PRODUCTION_CONTAINER_APP}" \
                        --resource-group "${PRODUCTION_RESOURCE_GROUP}" \
                        --revision-weight "${previous_revision}=100" \
                        --output none \
                        --only-show-errors
                    }

                    az containerapp ingress traffic set \
                    --name "${PRODUCTION_CONTAINER_APP}" \
                    --resource-group "${PRODUCTION_RESOURCE_GROUP}" \
                    --revision-weight "${previous_revision}=90" "${candidate_revision}=10" \
                    --output none \
                    --only-show-errors

                    echo "Canary traffic: 90% ${previous_revision}, 10% ${candidate_revision}"

                    candidate_hits=0

                    for attempt in $(seq 1 60); do
                    response="$(
                        curl \
                        --fail \
                        --silent \
                        --show-error \
                        "https://${stable_fqdn}/info"
                    )" || {
                        echo "Canary traffic check could not reach production"
                        rollback_to_previous
                        exit 1
                    }

                    observed_sha="$(printf '%s' "${response}" | jq -r '.build_sha')"

                    if [ "${observed_sha}" = "${IMAGE_TAG}" ]; then
                        candidate_hits=$((candidate_hits + 1))
                    fi

                    sleep 1
                    done

                    echo "Candidate responses through the production URL: ${candidate_hits}"

                    if [ "${candidate_hits}" -lt 1 ]; then
                    echo "No requests reached the candidate revision; restoring stable traffic"
                    rollback_to_previous
                    exit 1
                    fi

                    if ! curl \
                    --fail \
                    --silent \
                    --show-error \
                    --retry 12 \
                    --retry-all-errors \
                    --retry-delay 5 \
                    "https://${candidate_fqdn}/ready"; then
                    echo "Candidate failed readiness during the canary; restoring stable traffic"
                    rollback_to_previous
                    exit 1
                    fi

                    echo "Holding the candidate at 10% traffic for five minutes"
                    sleep 300

                    app_id="$(
                        az containerapp show \
                            --name "${PRODUCTION_CONTAINER_APP}" \
                            --resource-group "${PRODUCTION_RESOURCE_GROUP}" \
                            --query id \
                            --output tsv \
                            --only-show-errors
                    )"

                    metric_response="$(
                        az monitor metrics list \
                            --resource "${app_id}" \
                            --namespace "Microsoft.App/containerapps" \
                            --metrics "Requests" \
                            --aggregation "Total" \
                            --interval "PT1M" \
                            --offset "10m" \
                            --filter "revisionName eq '${candidate_revision}' and statusCodeCategory eq '5xx'" \
                            --output json \
                            --only-show-errors
                    )" || {
                        echo "Could not read candidate Azure Monitor metrics; restoring stable traffic"
                        rollback_to_previous
                        exit 1
                    }

                    candidate_5xx="$(
                        printf '%s' "${metric_response}" | \
                        jq '[.value[0].timeseries[]?.data[]?.total // 0] | add // 0'
                    )" || {
                        echo "Could not parse candidate Azure Monitor metrics; restoring stable traffic"
                        rollback_to_previous
                        exit 1
                    }

                    echo "Candidate 5xx requests during canary: ${candidate_5xx}"

                    if [ "${candidate_5xx}" -gt 0 ]; then
                        echo "Candidate returned 5xx responses; restoring stable traffic"
                        rollback_to_previous
                        exit 1
                    fi

                    if ! az containerapp ingress traffic set \
                      --name "${PRODUCTION_CONTAINER_APP}" \
                      --resource-group "${PRODUCTION_RESOURCE_GROUP}" \
                      --revision-weight "${candidate_revision}=100" \
                      --output none \
                      --only-show-errors; then
                      echo "Could not complete canary promotion; restoring stable traffic"
                      rollback_to_previous
                      exit 1
                    fi

                    echo "Production traffic now targets ${candidate_revision}"

                    post_promotion_failed=false

                    if [ "${FORCE_PRODUCTION_ROLLBACK:-false}" = "true" ]; then
                      echo "Controlled rollback drill requested; intentionally failing post-promotion verification"
                      post_promotion_failed=true
                    elif ! curl \
                      --fail \
                      --silent \
                      --show-error \
                      --retry 24 \
                      --retry-all-errors \
                      --retry-delay 5 \
                      "https://${stable_fqdn}/ready"; then
                      post_promotion_failed=true
                    elif ! run_authenticated_smoke_test "https://${stable_fqdn}"; then
                      post_promotion_failed=true
                    fi

                    if [ "${post_promotion_failed}" = "true" ]; then
                      echo "Stable production verification failed or rollback drill was requested; restoring ${previous_revision}"

                      az containerapp ingress traffic set \
                        --name "${PRODUCTION_CONTAINER_APP}" \
                        --resource-group "${PRODUCTION_RESOURCE_GROUP}" \
                        --revision-weight "${previous_revision}=100" \
                        --output none \
                        --only-show-errors

                      exit 1
                    fi

                    unset api_access_token
                    echo "Production promotion succeeded: ${candidate_revision}"
                '''
            }
        }

    }

    post {
        always {
            junit allowEmptyResults: true, testResults: 'junit.xml'
            archiveArtifacts allowEmptyArchive: true, artifacts: 'coverage.xml'
            sh 'rm -rf "${AZURE_CONFIG_DIR}"'
        }
    }
}
