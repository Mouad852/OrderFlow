FROM python:3.12.16-slim-bookworm@sha256:0f086103b026048cc50cb5da25ec435c023c5241a83fc44daea593377abc61c4
ARG BUILD_SHA=development
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    BUILD_SHA=${BUILD_SHA} \
    PATH="/app/.venv/bin:${PATH}"

WORKDIR /app

RUN pip install --no-cache-dir "uv==0.13.6" \
    && groupadd --system orderflow \
    && useradd --system --gid orderflow --home-dir /app orderflow

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

COPY alembic ./alembic
COPY alembic.ini ./
COPY app ./app

RUN chown --recursive orderflow:orderflow /app

USER orderflow

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
