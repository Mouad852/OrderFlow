FROM {{ jenkins_docker_cli_image }} AS docker-cli

FROM {{ jenkins_agent_base_image }}

USER root

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        jq \
        tar \
        unzip \
    && rm -rf /var/lib/apt/lists/*

ARG TERRAFORM_VERSION={{ jenkins_terraform_version }}

RUN terraform_archive="terraform_${TERRAFORM_VERSION}_linux_amd64.zip" \
    && curl --fail --location --silent --show-error \
        "https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/${terraform_archive}" \
        --output "/tmp/${terraform_archive}" \
    && curl --fail --location --silent --show-error \
        "https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_SHA256SUMS" \
        --output /tmp/terraform_SHA256SUMS \
    && cd /tmp \
    && grep " ${terraform_archive}$" terraform_SHA256SUMS \
        | sha256sum --check --status \
    && unzip -q "${terraform_archive}" -d /usr/local/bin \
    && rm -f "${terraform_archive}" terraform_SHA256SUMS \
    && terraform version

ARG TRIVY_VERSION={{ jenkins_trivy_version }}

RUN trivy_archive="trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz" \
    && curl --fail --location --silent --show-error \
        "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/${trivy_archive}" \
        --output "/tmp/${trivy_archive}" \
    && curl --fail --location --silent --show-error \
        "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_checksums.txt" \
        --output "/tmp/trivy_${TRIVY_VERSION}_checksums.txt" \
    && cd /tmp \
    && grep " ${trivy_archive}$" "trivy_${TRIVY_VERSION}_checksums.txt" \
        | sha256sum --check --status \
    && tar -xzf "${trivy_archive}" -C /usr/local/bin trivy \
    && rm -f "${trivy_archive}" "trivy_${TRIVY_VERSION}_checksums.txt" \
    && trivy --version

RUN curl --fail --location --silent --show-error \
        https://aka.ms/InstallAzureCLIDeb \
        --output /tmp/install-azure-cli.sh \
    && bash /tmp/install-azure-cli.sh \
    && rm -f /tmp/install-azure-cli.sh \
    && rm -rf /var/lib/apt/lists/*

ENV AZURE_EXTENSION_DIR=/opt/az/extensions

RUN mkdir -p "${AZURE_EXTENSION_DIR}" \
    && az extension add \
        --name containerapp \
        --upgrade \
    && chmod -R a+rX "${AZURE_EXTENSION_DIR}"

RUN curl --fail --location --silent --show-error \
    https://astral.sh/uv/0.13.6/install.sh \
    | env UV_INSTALL_DIR=/usr/local/bin sh

USER jenkins
